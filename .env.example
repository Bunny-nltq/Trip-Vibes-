# ==============================================================================
# Trip Vibes - Cấu hình Biến Môi trường (.env.example)
# Sao chép tệp này thành .env.local và điền các giá trị thích hợp.
# ==============================================================================

# 1. Google Gemini AI API (Phục vụ lập kế hoạch và bóc tách hóa đơn)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LIVE_AI_ENABLED=false
GEMINI_DAILY_CAP=40
PLAN_MAX_AI_CALLS=8

# 2. Dữ liệu Điểm đến & Bản đồ
DATA_MODE=snapshot
LIVE_DATA_ENABLED=false
NOMINATIM_USER_AGENT=TripVibes/1.0 (contact@tripvibes.vn)

# 3. Thông tin Website & Triển khai
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_DEMO=false

# 4. Tùy chọn Bên ngoài (Optional Third-Party Keys)
UNSPLASH_ACCESS_KEY=
EXCHANGE_RATE_API_KEY=
TAVILY_API_KEY=
